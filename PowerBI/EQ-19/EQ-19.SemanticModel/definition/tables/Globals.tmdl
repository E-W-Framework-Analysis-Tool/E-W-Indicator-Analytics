			    ISFILTERED('bi vw_DimNeglectedOrDelinquentStatus'[NeglectedOrDelinquentStatus])
			    ||      
			    ISFILTERED('Geography Value Slicer'[Organization Hierarchy]),
			    
			         IF(
			            ISFILTERED('bi vw_DimSchoolYears'[SchoolYear]),
			            "> Cohort Year: " & CONCATENATEX(VALUES('bi vw_DimSchoolYears'[SchoolYear]), 'bi vw_DimSchoolYears'[SchoolYear], ", "),
			            ""
			        )
			        & " " & 
			         IF(
			            ISFILTERED('bi vw_DimCohortGraduationYears'[CohortGraduationYear]),
			            "> Graduation Year: " & CONCATENATEX(VALUES('bi vw_DimCohortGraduationYears'[CohortGraduationYear]), 'bi vw_DimCohortGraduationYears'[CohortGraduationYear], ", "),
			            ""
			        )
			        & " " & 
			         IF(
			            ISFILTERED(LimitedGraduationYears[CohortGraduationYear]),
			            "> Graduation Year: " & CONCATENATEX(VALUES(LimitedGraduationYears[CohortGraduationYear]), LimitedGraduationYears[CohortGraduationYear], ", "),
			            ""
			        )       
			        & " " & 
			         IF(
			            ISFILTERED('bi vw_DimK12Schools'[SeaOrganizationName]),
			            "> SEAs: " & CONCATENATEX(VALUES('bi vw_DimK12Schools'[SeaOrganizationName]), 'bi vw_DimK12Schools'[SeaOrganizationName], ", "),
			            ""
			        )     
			        & " " & 
			        IF(
			            ISFILTERED('bi vw_DimK12Schools'[LeaOrganizationName]),
			            "> LEAs: " & CONCATENATEX(VALUES('bi vw_DimK12Schools'[LeaOrganizationName]), 'bi vw_DimK12Schools'[LeaOrganizationName], ", "),
			            ""
			        )
			        & " " & 
			        IF(
			            ISFILTERED('bi vw_DimK12Schools'[K12SchoolName]),
			            "> School: " & CONCATENATEX(VALUES('bi vw_DimK12Schools'[K12SchoolName]), 'bi vw_DimK12Schools'[K12SchoolName], ", "),
			            ""
			        )
			        & " " & 
			        IF(
			            ISFILTERED('bi vw_DimK12Schools'[SchoolTypeCode]),
			            "> School Type: " & CONCATENATEX(VALUES('bi vw_DimK12Schools'[SchoolTypeCode]), 'bi vw_DimK12Schools'[SchoolTypeCode], ", "),
			            ""
			        )
			        & " " & 
			        IF(
			            ISFILTERED('bi vw_DimDisabilityStatuses'[DisabilityStatus]),
			            "> Disability Type: " & CONCATENATEX(VALUES('bi vw_DimDisabilityStatuses'[DisabilityStatus]), 'bi vw_DimDisabilityStatuses'[DisabilityStatus], ", "),
			            ""
			        )
			        & " " & 
			        IF(
			            ISFILTERED('bi vw_DimEnglishLearnerStatuses'[EnglishLearnerStatus]),
			            "> English Learner Status: " & CONCATENATEX(VALUES('bi vw_DimEnglishLearnerStatuses'[EnglishLearnerStatus]), 'bi vw_DimEnglishLearnerStatuses'[EnglishLearnerStatus], ", "),
			            ""
			        )
			        & " " &
			        IF(
			            ISFILTERED('bi vw_DimRaces'[RaceEthnicity]),
			            "> Race/Ethnicity: " & CONCATENATEX(VALUES('bi vw_DimRaces'[RaceEthnicity]), 'bi vw_DimRaces'[RaceEthnicity], ", "),
			            ""
			        )
			        & " " &
			        IF(
			            ISFILTERED('bi vw_DimHomelessnessStatuses'[HomelessnessStatus]),
			            "> Homelessness Status: " & CONCATENATEX(VALUES('bi vw_DimHomelessnessStatuses'[HomelessnessStatus]), 'bi vw_DimHomelessnessStatuses'[HomelessnessStatus], ", "),
			            ""
			        )
			        & " " &
			        IF(
