table 'Economic Return'
	lineageTag: 077f38bd-a11d-4607-b96a-a7cd3c834269

	measure '% High School Economic Return' = ```
			
			DIVIDE(
			    CALCULATE(
			        COUNT('reporting RDS_FactEconomicReturn'[K12StudentId]), 
			        'reporting RDS_FactEconomicReturn'[StudentCategory] = 1, 
			        'reporting RDS_FactEconomicReturn'[MeetingEconomicReturn] = 1
			    ),
			    CALCULATE(
			        COUNT('reporting RDS_FactEconomicReturn'[K12StudentId]), 
			        'reporting RDS_FactEconomicReturn'[StudentCategory] = 1
			    ),
			    0
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2c57ff33-f42c-41c7-8ae5-2450649871e2

	measure '% Postsecondary Economic Return' = ```
			
			DIVIDE(
			    CALCULATE(
			        COUNT('reporting RDS_FactEconomicReturn'[K12StudentId]), 
			        'reporting RDS_FactEconomicReturn'[StudentCategory] = 2, 
			        'reporting RDS_FactEconomicReturn'[MeetingEconomicReturn] = 1
			    ),
			    CALCULATE(
			        COUNT('reporting RDS_FactEconomicReturn'[K12StudentId]), 
			        'reporting RDS_FactEconomicReturn'[StudentCategory] = 2
			    ),
			    0
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 32ab7175-e2a3-435b-b988-6344a1cab99f

