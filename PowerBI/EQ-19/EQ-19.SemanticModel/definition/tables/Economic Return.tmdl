			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2041370e-9314-43d2-a027-2471a2831911

	measure '% High School Economic Return Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineGraduationYears[CohortGraduationYear])
			RETURN
			CALCULATE(
			    [% High School Economic Return],
			    'bi vw_DimSchoolYears'[SchoolYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimSchoolYears')
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 093f4306-96bb-4da0-a3a4-70dd922e81a2

	measure '% Postsecondary Economic Return Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineGraduationYears[CohortGraduationYear])
