table 'Enrollment in Graduate Education'
	lineageTag: a34fe3fd-4aea-45b2-ba18-b81f970e624e

	measure YearsToComplete = ```
			
			DATEDIFF(
			    CALCULATE(MIN('bi vw_FactPsStudentEnrollments'[SchoolYear])), 
			    MAX('bi vw_FactPsStudentAcademicAwards'[AcademicAwardDate].[Year]), 
			    YEAR
			)
			```
		formatString: 0
		lineageTag: 94edb3c3-d10c-4476-bdf1-7f45c29d2678

	measure 'Total Cohort Count' = ```
			
			CALCULATE(
			    DISTINCTCOUNT('bi vw_FactPsStudentEnrollments'[PSStudentId]),
			    ALLEXCEPT(
			        'bi vw_FactPsStudentEnrollments', 
			        'bi vw_FactPsStudentEnrollments'[SchoolYear]
			    )
			)
			```
		formatString: 0
		lineageTag: 806f4425-b97b-4ab6-a532-30f0fa498dd7

	measure '% Completion 100% Time' = ```
			
			VAR IntendedLength = 2
			RETURN
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('bi vw_FactPsStudentEnrollments'[PSStudentId]),
			        FILTER(
			            VALUES('bi vw_PS_DimStudents'[DimPsStudentId]), 
			            [YearsToComplete] <= IntendedLength
			        )
			    ),
			    [Total Cohort Count]
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cc3b8252-68bc-43cd-a946-42d301a765d8

	measure '% Completion 150% Time' = ```
			
			VAR IntendedLength = 3
			RETURN
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('bi vw_FactPsStudentEnrollments'[PSStudentId]),
			        FILTER(
			            VALUES('bi vw_PS_DimStudents'[DimPsStudentId]), 
			            [YearsToComplete] <= IntendedLength
			        )
			    ),
			    [Total Cohort Count]
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: eb7f14df-faa0-46d7-8a46-34347c21462b

	measure '% Completion 200% Time' = ```
			
			VAR IntendedLength = 4
			RETURN
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('bi vw_FactPsStudentEnrollments'[PSStudentId]),
			        FILTER(
			            VALUES('bi vw_PS_DimStudents'[DimPsStudentId]), 
			            [YearsToComplete] <= IntendedLength
			        )
			    ),
			    [Total Cohort Count]
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f2b41234-2e26-4464-a7d9-ff77b65bf8ed

	measure 'HS Graduates' = DISTINCTCOUNT('reporting RDS_FactK12GraduationCohorts'[K12StudentId])
		formatString: 0
		lineageTag: 38bf4d1c-5d9d-460d-ac15-5a3679ce9bb5

	measure 'Enrolled Undergrad' =
			
			CALCULATE(
			    DISTINCTCOUNT('reporting RDS_FactPsStudentEnrollments'[PsStudentId]),
			    KEEPFILTERS('reporting RDS_FactPsStudentEnrollments')
			)
		formatString: 0
		lineageTag: 6cd199fc-0505-4009-8bb3-e80e4553120f

	measure 'Enrolled Grad' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('reporting RDS_FactPsStudentEnrollments'[PsStudentId]),
			        CALCULATE(COUNT('reporting RDS_FactPsStudentEnrollments'[PsStudentId])) > 1
			    )
			)
		formatString: 0
		lineageTag: c2c520b4-200b-4fd9-867b-ea619ebc4558

	measure 'HS Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineGraduationYears[CohortGraduationYear])
			RETURN
			CALCULATE(
			    [HS Graduates],
			    'bi vw_DimCohortGraduationYears'[CohortGraduationYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimSchoolYears')
			)
		formatString: 0
		lineageTag: 4e606755-d1f3-4998-a731-94e52e96141c

	measure 'Undergrad Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineGraduationYears[CohortGraduationYear])
			RETURN
			CALCULATE(
			    [Enrolled Undergrad],
			    'bi vw_DimCohortGraduationYears'[CohortGraduationYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimSchoolYears')
			)
		formatString: 0
		lineageTag: 2b662ce3-ef6a-4335-924f-368732ff6f82

	measure 'Postgrad Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineGraduationYears[CohortGraduationYear])
			RETURN
			CALCULATE(
			    [Enrolled Grad],
			    'bi vw_DimCohortGraduationYears'[CohortGraduationYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimSchoolYears')
			)
		formatString: 0
		lineageTag: c4c22e3d-4665-49c8-971e-b612cbfd6527

	partition 'Enrollment in Graduate Education' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	changedProperty = Name

	annotation PBI_ResultType = Table

