table 'Enrollment in Graduate Education'
	lineageTag: a34fe3fd-4aea-45b2-ba18-b81f970e624e

	measure '% Postgrad Enrolled 1-5 Years Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineGraduationYears[CohortGraduationYear])
			RETURN
			CALCULATE(
			    [% Postgrad Enrolled 1-5 Years],
			    'bi vw_DimSchoolYears'[SchoolYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimSchoolYears')
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fa456567-0152-4237-98da-212aab3cfd33

	measure '% Postgrad Enrolled 6-10 Years Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineGraduationYears[CohortGraduationYear])
			RETURN
			CALCULATE(
			    [% Postgrad Enrolled 6-10 Years],
			    'bi vw_DimSchoolYears'[SchoolYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimSchoolYears')
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b9b9134c-f325-4689-a85c-8c0b97e53c83

	measure '% Postgrad Enrolled 1-5 Years' = ```
			
			VAR StudentsWithMultipleRecords =  FILTER(
			        VALUES('reporting RDS_FactPsStudentEnrollments'[PsStudentId]),
			        CALCULATE(COUNT('reporting RDS_FactPsStudentEnrollments'[PsStudentId])) > 1
			)
			VAR StudentCount = 
			    SUMX(
			        StudentsWithMultipleRecords,
			        VAR UndergradExit = CALCULATE(MIN('reporting RDS_FactPsStudentEnrollments'[EnrollmentExitDate]))
			        VAR PostgradEntry = CALCULATE(MAX('reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate]))
			        VAR YearDiff = YEAR(PostgradEntry) - YEAR(UndergradExit)
			        
			        RETURN IF(YearDiff >= 1 && YearDiff <= 5, 1, 0)
			    )
			
			RETURN 
			    DIVIDE(StudentCount, [Total Postgrad Students], 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6f2ee082-6701-444d-879d-de57b9436cae

	measure '% Postgrad Enrolled 6-10 Years' = ```
			
			VAR StudentsWithMultipleRecords =  FILTER(
			        VALUES('reporting RDS_FactPsStudentEnrollments'[PsStudentId]),
			        CALCULATE(COUNT('reporting RDS_FactPsStudentEnrollments'[PsStudentId])) > 1
			)
			VAR StudentCount = 
			    SUMX(
			        StudentsWithMultipleRecords,
			        VAR UndergradExit = CALCULATE(MIN('reporting RDS_FactPsStudentEnrollments'[EnrollmentExitDate]))
			        VAR PostgradEntry = CALCULATE(MAX('reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate]))
			        VAR YearDiff = YEAR(PostgradEntry) - YEAR(UndergradExit)
			        
			        RETURN IF(YearDiff >= 6 && YearDiff <= 10, 1, 0)
			    )
			
			RETURN 
			    DIVIDE(StudentCount, [Total Postgrad Students], 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b59e8309-524a-40eb-91b6-c861be0aa05a

