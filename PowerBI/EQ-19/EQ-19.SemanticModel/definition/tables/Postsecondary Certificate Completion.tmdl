	measure 'Count of Completion within 100% Program Length' = ```
			
			VAR factor = 1
			-- 1. Configuration & Context Variables
			VAR TargetCredentials = {"Certificate", "Associate's Degree", "Bachelor's Degree"}
			VAR TargetFieldOfStudy = {"BUSINESS", "ARTS", "OTHER", "STEM"}
			VAR CurrentCredential = SELECTEDVALUE('bi vw_DimPsAcademicAwardStatuses'[CredentialType])
			VAR CurrentFieldOfStudy = SELECTEDVALUE('bi vw_DimCipCodes'[FieldOfStudy])
			VAR IsValidRow = (
			                    (CurrentCredential IN TargetCredentials     || NOT ISFILTERED('bi vw_DimPsAcademicAwardStatuses'[CredentialType])) &&
			                    (CurrentFieldOfStudy in TargetFieldOfStudy  || NOT ISFILTERED('bi vw_DimCipCodes'[FieldOfStudy]))
			                )
			
			-- 2. Filter the Student List
			-- We only look at students who have records matching our 3 target types
			VAR QualifiedStudents = 
			    CALCULATETABLE(
			        VALUES('reporting RDS_FactPsStudentEnrollments'[PsStudentId]),
			        'bi vw_DimPsAcademicAwardStatuses'[CredentialType] IN TargetCredentials,
			        'bi vw_DimCipCodes'[FieldOfStudy] IN TargetFieldOfStudy
			    )
			
			-- 3. Identify "On-Time" Students
			-- We filter the QualifiedStudents list down to only those meeting the time requirement
			VAR OnTimeStudentsTable = 
			    FILTER(
			        QualifiedStudents,
			        VAR StartDate = 
			            CALCULATE(
			                MIN('reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate]),
			                'bi vw_DimPsAcademicAwardStatuses'[CredentialType] IN TargetCredentials,
			                'bi vw_DimCipCodes'[FieldOfStudy] IN TargetFieldOfStudy
			            )
			        VAR AwardDate = 
			            CALCULATE(
			                MIN('reporting RDS_FactPsStudentEnrollments'[EnrollmentExitDate]),
			                'bi vw_DimPsAcademicAwardStatuses'[CredentialType] IN TargetCredentials,
			                'bi vw_DimCipCodes'[FieldOfStudy] IN TargetFieldOfStudy
			            )
			        VAR IntendedYears = 
			            CALCULATE(
			                MAX('bi vw_DimPsAcademicAwardStatuses'[IntendedYears]),
			                'bi vw_DimPsAcademicAwardStatuses'[CredentialType] IN TargetCredentials,
			                'bi vw_DimCipCodes'[FieldOfStudy] IN TargetFieldOfStudy
			            )
			        
			        VAR ActualMonths = DATEDIFF(StartDate, AwardDate, MONTH)
			        VAR AllowedMonths = IntendedYears * 12 * factor
			
			        RETURN
			            NOT ISBLANK(StartDate) && 
			            NOT ISBLANK(AwardDate) && 
			            NOT ISBLANK(IntendedYears) &&
			            ActualMonths <= AllowedMonths
			    )
			
			-- 4. Final Aggregations
			VAR OnTimeCount = COUNTROWS(OnTimeStudentsTable)
			VAR Result = DIVIDE(OnTimeCount, [HS Graduates], 0)
			
			-- 5. Execution Logic
			RETURN
			    IF(IsValidRow, OnTimeCount, BLANK())
			```
		formatString: 0
		lineageTag: 4d085aa0-b7e2-4f9d-a362-d106a5c18c68

	measure 'Count of Completion within 150% Program Length' = ```
			
