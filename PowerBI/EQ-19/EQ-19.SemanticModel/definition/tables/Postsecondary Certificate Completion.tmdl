table 'Postsecondary Certificate Completion'
	lineageTag: 38c775e6-9153-4b66-8c1e-b0a9ee4a5b3c

	measure '100% Program Length' = ```
			
			-- Get a list of unique students in the currently filtered cohort
			VAR StudentList = VALUES('reporting RDS_FactPsStudentEnrollments'[PsStudentId])
			
			VAR StudentCount =
			    COUNTROWS(
			        FILTER(
			            StudentList,
			            VAR StudentID = [PsStudentId]
			            
			            -- 1. Get ONLY the earliest enrollment date (ignores post-grad re-entry)
			            VAR InitialStartDate = 
			                CALCULATE(
			                    MIN('reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate])
			                )
			            
			            -- 2. Get the award details (firsProgrr that student)
			            VAR MinAwardDate = 
			                CALCULATE(
			                    MIN('reporting RDS_FactPsStudentAcademicAwards'[AcademicAwardDate]),
			                    'reporting RDS_FactPsStudentAcademicAwards'[PsStudentId] = StudentID
			                )
			            
			            VAR ProgramLengthMonths = 
			                CALCULATE(
			                    MAX('bi vw_DimPsAcademicAwardStatuses'[IntendedYears]),
			                   'reporting RDS_FactPsStudentAcademicAwards'[PsStudentId] = StudentID
			                )
			
			            -- 3. Calculate Deadlines using EDATE for precision
			            -- Assumes IntendedLength is in Months
			            VAR Deadline = EDATE(InitialStartDate, ProgramLengthMonths * 1)
			
			            RETURN
			                -- Student must have an award within the specific 150-200% window
			                NOT ISBLANK(MinAwardDate) &&
			                MinAwardDate <= Deadline
			        )
			    )
			RETURN DIVIDE(StudentCount, [Total Cohort Students], 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d5a7c1f7-55b5-406e-9ce1-1d88cd610224

	measure '150% Program Length' = ```
			
			VAR StudentList = VALUES('reporting RDS_FactPsStudentEnrollments'[PsStudentId])
			
			VAR StudentCount =
			    COUNTROWS(
			        FILTER(
			            StudentList,
			            VAR StudentID = [PsStudentId]
			            
			            -- 1. Get ONLY the earliest enrollment date (ignores post-grad re-entry)
			            VAR InitialStartDate = 
			                CALCULATE(
			                    MIN('reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate])
			                )
			            
			            -- 2. Get the award details (firsProgrr that student)
			            VAR MinAwardDate = 
			                CALCULATE(
			                    MIN('reporting RDS_FactPsStudentAcademicAwards'[AcademicAwardDate]),
			                    'reporting RDS_FactPsStudentAcademicAwards'[PsStudentId] = StudentID
			                )
			            
			            VAR ProgramLengthMonths = 
			                CALCULATE(
			                    MAX('bi vw_DimPsAcademicAwardStatuses'[IntendedYears]),
			                   'reporting RDS_FactPsStudentAcademicAwards'[PsStudentId] = StudentID
			                )
			
			            -- 3. Calculate Deadlines using EDATE for precision
			            -- Assumes IntendedLength is in Months
			            VAR Deadline = EDATE(InitialStartDate, ProgramLengthMonths * 1.5)
			
			            RETURN
			                -- Student must have an award within the specific 150-200% window
			                NOT ISBLANK(MinAwardDate) &&
			                MinAwardDate <= Deadline
			        )
			    )
			RETURN DIVIDE(StudentCount, [Total Cohort Students], 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 91a09af5-bc3c-49a9-af3e-b796d4b54297

	measure '200% Program Length' = ```
			
			VAR StudentList = VALUES('reporting RDS_FactPsStudentEnrollments'[PsStudentId])
			
			VAR StudentCount =
			    COUNTROWS(
			        FILTER(
			            StudentList,
			            VAR StudentID = [PsStudentId]
			            
			            -- 1. Get ONLY the earliest enrollment date (ignores post-grad re-entry)
			            VAR InitialStartDate = 
			                CALCULATE(
			                    MIN('reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate])
			                )
			            
			            -- 2. Get the award details (firsProgrr that student)
			            VAR MinAwardDate = 
			                CALCULATE(
			                    MIN('reporting RDS_FactPsStudentAcademicAwards'[AcademicAwardDate]),
			                    'reporting RDS_FactPsStudentAcademicAwards'[PsStudentId] = StudentID
			                )
			            
			            VAR ProgramLengthMonths = 
			                CALCULATE(
			                    MAX('bi vw_DimPsAcademicAwardStatuses'[IntendedYears]),
			                   'reporting RDS_FactPsStudentAcademicAwards'[PsStudentId] = StudentID
			                )
			
			            -- 3. Calculate Deadlines using EDATE for precision
			            -- Assumes IntendedLength is in Months
			            VAR Deadline = EDATE(InitialStartDate, ProgramLengthMonths * 2)
			
			            RETURN
			                -- Student must have an award within the specific 150-200% window
			                NOT ISBLANK(MinAwardDate) &&
			                MinAwardDate <= Deadline
			        )
			    )
			RETURN DIVIDE(StudentCount, [Total Cohort Students], 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9ea1c9bc-ba1d-4c36-84d9-a4b62862e747

	measure '100% Program Length Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineGraduationYears[CohortGraduationYear])
			RETURN
			CALCULATE(
			    [100% Program Length],
			    'bi vw_DimCohortGraduationYears'[CohortGraduationYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimSchoolYears')
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4efb2153-d6a2-4df9-b78f-72e7363c9f1f

