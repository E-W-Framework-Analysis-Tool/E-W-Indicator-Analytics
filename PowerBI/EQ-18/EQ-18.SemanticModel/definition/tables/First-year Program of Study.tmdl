		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fdc0f7bc-1309-4008-8229-3eeec1253238

	measure 'Students 9+ Meta-Major Credits' = ```
			
			VAR TargetFieldOfStudy = {"BUSINESS", "ARTS", "OTHER", "STEM"}
			VAR TargetCredentials = {"Certificate", "Associate's Degree", "Bachelor's Degree"}
			VAR CurrentCredential = SELECTEDVALUE('bi vw_DimPsAcademicAwardStatuses'[CredentialType])
			VAR CurrentFieldOfStudy = SELECTEDVALUE('bi vw_DimCipCodes'[FieldOfStudy])
			VAR IsValidRow = (
			                    (CurrentCredential IN TargetCredentials     || NOT ISFILTERED('bi vw_DimPsAcademicAwardStatuses'[CredentialType])) &&
			                    (CurrentFieldOfStudy in TargetFieldOfStudy  || NOT ISFILTERED('bi vw_DimCipCodes'[FieldOfStudy]))
			                )
			
			VAR QualifiedStudents = 
			SUMX(
			    VALUES('reporting RDS_FactPsStudentEnrollments'[PsStudentId]),
			    VAR _CurrentStudent = 'reporting RDS_FactPsStudentEnrollments'[PsStudentId]
			    VAR _StudentStart = [Student First-Year Window]
			    VAR _StudentEnd = EDATE(_StudentStart, 12)
			    
			    -- Calculate Attempted for Intensity and Earned for Completion
			    VAR CreditsEarned = 
			            CALCULATE(
			                SUM('reporting RDS_FactPsStudentCourseTranscripts'[NumberOfCreditsEarned]),
			                'reporting RDS_DimPsCourses'[CourseCodeSystemCode] = "Meta-Major",
			                -- Filter transcripts to only those occurring on or before the student's window
			                'reporting RDS_FactPsStudentCourseTranscripts'[PsStudentId] = _CurrentStudent,
			                'reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate] <= _StudentEnd,
			            'bi vw_DimPsAcademicAwardStatuses'[CredentialType] IN TargetCredentials,
			            'bi vw_DimCipCodes'[FieldOfStudy] IN TargetFieldOfStudy
			            )
			
			    VAR _HasValidCredential = 
			        CALCULATE(
			            COUNTROWS('bi vw_DimPsAcademicAwardStatuses'),
			            'bi vw_DimPsAcademicAwardStatuses'[CredentialType] IN TargetCredentials,
			            'bi vw_DimCipCodes'[FieldOfStudy] IN TargetFieldOfStudy,
			            'reporting RDS_FactPsStudentEnrollments'[PsStudentId] = _CurrentStudent
			        )
			
			    -- Logic: Full Time (Attempted >= 30) AND Completed 30 (Earned >= 30)
			    RETURN
			    IF(
			        CreditsEarned >= 9 && 
			        _HasValidCredential > 0,
			        1, 0
			    )
			)
			
			RETURN
			    IF(IsValidRow, QualifiedStudents, BLANK())
			```
		formatString: 0
		lineageTag: 9fddcc6f-188a-41bd-86e3-1dec2e12398b

	measure 'Total Enrolled Students' = ```
			
			VAR TargetCredentials = {"Certificate", "Associate's Degree", "Bachelor's Degree"}
			VAR TargetFieldOfStudy = {"BUSINESS", "ARTS", "OTHER", "STEM"}
			
			VAR CurrentCredential = SELECTEDVALUE('bi vw_DimPsAcademicAwardStatuses'[CredentialType])
			VAR CurrentFieldOfStudy = SELECTEDVALUE('bi vw_DimCipCodes'[FieldOfStudy])
			VAR IsValidRow = (
			                    (CurrentCredential IN TargetCredentials     || NOT ISFILTERED('bi vw_DimPsAcademicAwardStatuses'[CredentialType])) &&
			                    (CurrentFieldOfStudy in TargetFieldOfStudy  || NOT ISFILTERED('bi vw_DimCipCodes'[FieldOfStudy]))
			                )
			
			-- 1. Identify students with at least 2 enrollment records across all time
			VAR UndergradStudents = 
			    FILTER(
			        ADDCOLUMNS(
			            VALUES('reporting RDS_FactPsStudentEnrollments'[PsStudentId]),
			            "IsUndergrad", 
			            CALCULATE(
			                COUNTROWS('reporting RDS_FactPsStudentEnrollments'),
			                ALLEXCEPT('reporting RDS_FactPsStudentEnrollments', 'reporting RDS_FactPsStudentEnrollments'[PsStudentId])
			            ) >= 1
			        ),
			        [IsUndergrad] = TRUE
			    )
			
			VAR OnlyUndergradIds = SELECTCOLUMNS(UndergradStudents, "PsStudentId", [PsStudentId])
			
			-- 2. Calculate the distinct count applying the context of the visual
			VAR Result = 
			    CALCULATE(
			        DISTINCTCOUNT('reporting RDS_FactPsStudentEnrollments'[PsStudentId]),
			        KEEPFILTERS(OnlyUndergradIds),
			        'bi vw_DimPsAcademicAwardStatuses'[CredentialType] IN TargetCredentials,
			        'bi vw_DimCipCodes'[FieldOfStudy] IN TargetFieldOfStudy
			    )
			
			-- 3. Execution Logic
			RETURN
			    IF(IsValidRow, Result, BLANK())
			```
		formatString: 0
		lineageTag: 78706a72-b8cf-4e61-9f94-3d05b068586a

