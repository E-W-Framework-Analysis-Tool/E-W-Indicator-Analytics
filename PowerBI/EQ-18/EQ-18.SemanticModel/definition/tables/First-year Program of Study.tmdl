table 'First-year Program of Study'
	lineageTag: b2fc4fb6-1eda-4c9a-8bcf-130aa60b17e9

	measure '% First-year Program of Study Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineGraduationYears[CohortGraduationYear])
			RETURN
			CALCULATE(
			    'First-year Program of Study'[% Students 9+ Meta-Major Credits],
			    'bi vw_DimCohortGraduationYears'[CohortGraduationYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimSchoolYears')
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 48f08ad4-58ec-42a5-944c-9d5fce06a88e

	measure '% Students 9+ Meta-Major Credits' =
			
			DIVIDE([Students 9+ Meta-Major Credits], [Total Enrolled Students], 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fdc0f7bc-1309-4008-8229-3eeec1253238

	measure 'Students 9+ Meta-Major Credits' = ```
			
			VAR TargetCredentials = {"Certificate", "Associate's Degree", "Bachelor's Degree"}
			VAR TargetFieldOfStudy = {"BUSINESS", "ARTS", "OTHER", "STEM"}
			
			VAR CurrentCredential = SELECTEDVALUE('bi vw_DimPsAcademicAwardStatuses'[CredentialType])
			VAR CurrentFieldOfStudy = SELECTEDVALUE('bi vw_DimCipCodes'[FieldOfStudy])
			
			VAR IsValidRow = 
			    (ISBLANK(CurrentCredential) || CurrentCredential IN TargetCredentials) &&
			    (ISBLANK(CurrentFieldOfStudy) || CurrentFieldOfStudy IN TargetFieldOfStudy)
			
			-- STRICT INTERSECTION: Grab only the students who belong to the current visual/slicer's active filters
			VAR StudentsInContext = 
			    CALCULATETABLE(
			        VALUES('reporting RDS_FactPsStudentEnrollments'[PsStudentId]),
			        'bi vw_DimPsAcademicAwardStatuses'[CredentialType] IN TargetCredentials,
			        'bi vw_DimCipCodes'[FieldOfStudy] IN TargetFieldOfStudy
			    )
			
			VAR QualifiedStudents = 
			SUMX(
			    StudentsInContext,
			    VAR _CurrentStudent = 'reporting RDS_FactPsStudentEnrollments'[PsStudentId]
			    VAR _StudentStart = [Student First-Year Window]
			    VAR _StudentEnd = EDATE(_StudentStart, 12)
			    
			    -- Calculate Meta-Major Credits safely ignoring visual level constraints inside loop
			    VAR CreditsEarned = 
			        CALCULATE(
			            SUM('reporting RDS_FactPsStudentCourseTranscripts'[NumberOfCreditsEarned]),
			            'reporting RDS_DimPsCourses'[CourseCodeSystemCode] = "Meta-Major",
			            'reporting RDS_FactPsStudentCourseTranscripts'[PsStudentId] = _CurrentStudent,
			            'reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate] <= _StudentEnd,
			            REMOVEFILTERS('bi vw_DimCipCodes'),
			            'bi vw_DimCipCodes'[FieldOfStudy] IN TargetFieldOfStudy,
			            REMOVEFILTERS('bi vw_DimPsAcademicAwardStatuses'),
			            'bi vw_DimPsAcademicAwardStatuses'[CredentialType] IN TargetCredentials
			        )
			
			    VAR _HasValidCredential = 
			        CALCULATE(
			            COUNTROWS('bi vw_DimPsAcademicAwardStatuses'),
			            'bi vw_DimPsAcademicAwardStatuses'[CredentialType] IN TargetCredentials,
			            'bi vw_DimCipCodes'[FieldOfStudy] IN TargetFieldOfStudy,
			            'reporting RDS_FactPsStudentEnrollments'[PsStudentId] = _CurrentStudent
			        )
			
			    RETURN
			    IF(
			        CreditsEarned >= 9 && 
			        _HasValidCredential > 0,
			        1, 0
			    )
			)
			
			RETURN
			    IF(IsValidRow, QualifiedStudents, BLANK())
			```
		formatString: 0
		lineageTag: 9fddcc6f-188a-41bd-86e3-1dec2e12398b

	measure 'Total Enrolled Students' = ```
			
			VAR TargetCredentials = {"Certificate", "Associate's Degree", "Bachelor's Degree"}
			VAR TargetFieldOfStudy = {"BUSINESS", "ARTS", "OTHER", "STEM"}
			
			VAR CurrentCredential = SELECTEDVALUE('bi vw_DimPsAcademicAwardStatuses'[CredentialType])
			VAR CurrentFieldOfStudy = SELECTEDVALUE('bi vw_DimCipCodes'[FieldOfStudy])
			
			VAR IsValidRow = 
			    (ISBLANK(CurrentCredential) || CurrentCredential IN TargetCredentials) &&
			    (ISBLANK(CurrentFieldOfStudy) || CurrentFieldOfStudy IN TargetFieldOfStudy)
			
			-- STRICT INTERSECTION: Evaluates distinct student IDs only where the selections strictly overlap
			VAR ValidIntersectingStudents = 
			    CALCULATETABLE(
			        VALUES('reporting RDS_FactPsStudentEnrollments'[PsStudentId]),
			        'bi vw_DimPsAcademicAwardStatuses'[CredentialType] IN TargetCredentials,
			        'bi vw_DimCipCodes'[FieldOfStudy] IN TargetFieldOfStudy
			    )
			
			VAR Result = 
			    CALCULATE(
			        DISTINCTCOUNT('reporting RDS_FactPsStudentEnrollments'[PsStudentId]),
			        KEEPFILTERS(ValidIntersectingStudents)
			    )
			
			RETURN
			    IF(IsValidRow, Result, BLANK())
			```
		formatString: 0
		lineageTag: 78706a72-b8cf-4e61-9f94-3d05b068586a

	partition 'First-year Program of Study' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

