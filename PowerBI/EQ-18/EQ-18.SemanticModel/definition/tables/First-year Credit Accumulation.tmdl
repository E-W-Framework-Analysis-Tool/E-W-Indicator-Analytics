table 'First-year Credit Accumulation'
	lineageTag: d42d6ce4-0bf7-47d9-81c9-658d4412785d

	measure '% FT Students Completing 30 Credits' = ```
			
			VAR StudentBase = 
			    FILTER(
			        VALUES('reporting RDS_FactPsStudentEnrollments'[PsStudentId]),
			        [Attempted_Credits_YR1] >= 30
			    )
			VAR SuccessfulStudents = 
			    FILTER(
			        StudentBase,
			        [Earned_Credits_YR1] >= 30
			    )
			VAR Denominator = COUNTROWS(StudentBase)
			VAR Numerator = COUNTROWS(SuccessfulStudents)
			
			RETURN 
			    DIVIDE(Numerator, Denominator, 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9bc86cb3-1b6a-49f5-a36e-482bdd8e790d

	measure '% HT Students Completing 15 Credits' = ```
			
			VAR StudentBase = 
			    FILTER(
			        VALUES('reporting RDS_FactPsStudentEnrollments'[PsStudentId]),
			        [Attempted_Credits_YR1] <= 18
			    )
			VAR SuccessfulStudents = 
			    FILTER(
			        StudentBase,
			        [Earned_Credits_YR1] >= 15
			    )
			VAR Denominator = COUNTROWS(StudentBase)
			VAR Numerator = COUNTROWS(SuccessfulStudents)
			
			RETURN 
			    DIVIDE(Numerator, Denominator, 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 529c0c5e-94f7-44e4-86cb-a666028baa69

	measure '% FT Students Completing 30 Credits Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineGraduationYears[CohortGraduationYear])
			RETURN
			CALCULATE(
			    [% FT Students Completing 30 Credits],
			    'bi vw_DimSchoolYears'[SchoolYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimSchoolYears')
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 465d5243-47bc-4b94-a7cd-e69c1c846fb4

	measure '% HT Students Completing 15 Credits Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineGraduationYears[CohortGraduationYear])
			RETURN
			CALCULATE(
			    [% HT Students Completing 15 Credits],
			    'bi vw_DimSchoolYears'[SchoolYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimSchoolYears')
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ad966f6c-fe23-4b88-b8dd-5c0a08f9583b

	measure StudentFirstYearWindow = ```
			
			VAR MinEntryDate = 
			    CALCULATE(
			        MIN('reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate]),
			        ALLEXCEPT('reporting RDS_FactPsStudentEnrollments', 'reporting RDS_FactPsStudentEnrollments'[PsStudentId])
			    )
			RETURN
			    MinEntryDate + 365
			```
		formatString: General Date
		lineageTag: 2e8102b8-e56d-43c7-9c26-f456e29862fe

	measure Attempted_Credits_YR1 =
			
			CALCULATE(
			    SUM('reporting RDS_FactPsStudentCourseTranscripts'[NumberOfCreditsAttempted]),
			    FILTER(
			        'reporting RDS_FactPsStudentEnrollments',
			        'reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate] <= [StudentFirstYearWindow]
			    )
			)
		lineageTag: d4d8664c-e390-488e-a049-c31c3855aa9a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Earned_Credits_YR1 =
			
			CALCULATE(
			    SUM('reporting RDS_FactPsStudentCourseTranscripts'[NumberOfCreditsEarned]),
			    FILTER(
			        'reporting RDS_FactPsStudentEnrollments',
			        'reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate] <= [StudentFirstYearWindow]
			    )
			)
		lineageTag: 0b50dfb7-274d-4279-b88d-10db49333b5e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'First-year Credit Accumulation' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

