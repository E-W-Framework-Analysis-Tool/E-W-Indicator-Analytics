table 'First-year Credit Accumulation'
	lineageTag: d42d6ce4-0bf7-47d9-81c9-658d4412785d

	measure '% Full-Time Students Completing 30 Credits' = ```
			
			VAR Denominator = [Total Undergrad Enrolled Students]
			VAR Numerator = [FT Students 30 Credits]
			
			RETURN 
			    DIVIDE(Numerator, Denominator, 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9bc86cb3-1b6a-49f5-a36e-482bdd8e790d

	measure '% Part-Time Students Completing 15 Credits' = ```
			
			VAR Denominator = [Total Undergrad Enrolled Students]
