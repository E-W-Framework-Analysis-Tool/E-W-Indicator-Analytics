table 'Gateway Course Completion'
	lineageTag: e48fecd6-4e9e-4c6b-80f1-83cf286c743c

	measure '% students completing English' = ```
			
			VAR Threshold = 3
			VAR MetaMajorStudents = 
			    FILTER(
			        VALUES('reporting RDS_FactPsStudentCourseTranscripts'[PsStudentId]),
			        VAR CurrentStudent = 'reporting RDS_FactPsStudentCourseTranscripts'[PsStudentId]
			        
			        -- Get the specific first year window for THIS student only
			        VAR SpecificWindow = 
			            CALCULATE(
			                [Student First-Year Window], 
			                'reporting RDS_FactPsStudentEnrollments'[PsStudentId] = CurrentStudent
			            )
			            
			        VAR CreditsEarned = 
			            CALCULATE(
			                SUM('reporting RDS_FactPsStudentCourseTranscripts'[NumberOfCreditsEarned]),
			                'reporting RDS_DimPsCourses'[CourseTitle] = "English",
			                -- Filter transcripts to only those occurring on or before the student's window
			                'reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate] <= SpecificWindow
			            )
			        RETURN 
			            CreditsEarned >= Threshold
			    )
			    
			VAR TotalStudents = [1st Year Enrolled Students]
			VAR SuccessfulStudents = COUNTROWS(MetaMajorStudents)
			
			RETURN
			    DIVIDE(SuccessfulStudents, TotalStudents, 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2d5650b4-664a-4c88-9a84-547b4ef92f5e

	measure '% students completing Math' = ```
			
			VAR Threshold = 3
			VAR MetaMajorStudents = 
			    FILTER(
			        VALUES('reporting RDS_FactPsStudentCourseTranscripts'[PsStudentId]),
			        VAR CurrentStudent = 'reporting RDS_FactPsStudentCourseTranscripts'[PsStudentId]
			        
			        -- Get the specific first year window for THIS student only
			        VAR SpecificWindow = 
			            CALCULATE(
			                [Student First-Year Window], 
			                'reporting RDS_FactPsStudentEnrollments'[PsStudentId] = CurrentStudent
			            )
			            
			        VAR CreditsEarned = 
			            CALCULATE(
			                SUM('reporting RDS_FactPsStudentCourseTranscripts'[NumberOfCreditsEarned]),
			                'reporting RDS_DimPsCourses'[CourseTitle] = "Math",
			                -- Filter transcripts to only those occurring on or before the student's window
			                'reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate] <= SpecificWindow
			            )
			        RETURN 
			            CreditsEarned >= Threshold
			    )
			    
			VAR TotalStudents = [1st Year Enrolled Students]
			VAR SuccessfulStudents = COUNTROWS(MetaMajorStudents)
			
			RETURN
			    DIVIDE(SuccessfulStudents, TotalStudents, 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 99691e73-a0f7-4f05-b5bc-a1990dd8d9a9

	measure '% students completing English & Math' = ```
			
			VAR Threshold = 6
			VAR MetaMajorStudents = 
			    FILTER(
			        VALUES('reporting RDS_FactPsStudentCourseTranscripts'[PsStudentId]),
			        VAR CurrentStudent = 'reporting RDS_FactPsStudentCourseTranscripts'[PsStudentId]
			        
			        -- Get the specific first year window for THIS student only
			        VAR SpecificWindow = 
			            CALCULATE(
			                [Student First-Year Window], 
			                'reporting RDS_FactPsStudentEnrollments'[PsStudentId] = CurrentStudent
			            )
			            
			        VAR CreditsEarnedMath = 
			            CALCULATE(
			                SUM('reporting RDS_FactPsStudentCourseTranscripts'[NumberOfCreditsEarned]),
			                'reporting RDS_DimPsCourses'[CourseTitle] IN {"Math"},
			                -- Filter transcripts to only those occurring on or before the student's window
			                'reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate] <= SpecificWindow
			            )
			
			        VAR CreditsEarnedEnglish = 
			            CALCULATE(
			                SUM('reporting RDS_FactPsStudentCourseTranscripts'[NumberOfCreditsEarned]),
			                'reporting RDS_DimPsCourses'[CourseTitle] IN {"English"},
			                -- Filter transcripts to only those occurring on or before the student's window
			                'reporting RDS_FactPsStudentEnrollments'[EnrollmentEntryDate] <= SpecificWindow
			            )
			        RETURN 
			            CreditsEarnedMath + CreditsEarnedEnglish >= Threshold
			    )
			    
			VAR TotalStudents = [1st Year Enrolled Students]
			VAR SuccessfulStudents = COUNTROWS(MetaMajorStudents)
			
			RETURN
			    DIVIDE(SuccessfulStudents, TotalStudents, 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 05d059b5-4914-4e13-b27b-803ee70b1d97

	measure '% students completing English Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineGraduationYears[CohortGraduationYear])
			RETURN
			CALCULATE(
			    [% students completing English],
			    'bi vw_DimCohortGraduationYears'[CohortGraduationYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimSchoolYears')
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fcdfa6f8-2719-4096-8182-8e58232dcc5c

