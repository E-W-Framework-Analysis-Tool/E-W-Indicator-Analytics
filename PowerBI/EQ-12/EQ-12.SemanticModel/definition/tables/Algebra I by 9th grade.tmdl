table 'Algebra I by 9th grade'
	lineageTag: b9e2b3c4-c6f2-43db-85a1-a3b4b6c75aa8

	measure 'Algebra I Pass Count' = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[K12StudentId]), 'bi vw_FactK12StudentCourseSections'[GradeLevelCode] = "09", CONTAINSSTRING('bi vw_DimK12Courses'[CourseTitle], "Algebra I"), 'bi vw_FactK12StudentCourseSections'[LetterGradeEarned] <> "F")
		formatString: 0
		displayFolder: Algebra I Completion Measures
		lineageTag: a44bf016-fb7a-4068-afc1-289e3a32477f

	measure 'Algebra I Success Rate' = IF([Total 9th Graders] = 0, 0, DIVIDE([Algebra I Pass Count], [Total 9th Graders], 0))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Algebra I Completion Measures
		lineageTag: bce3ee81-d942-46a3-b108-dd2c9d3cc84a

	measure 'Total 9th Graders' = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentEnrollments'[K12StudentId]), 'bi vw_DimGradeLevels'[GradeLevelCode]= "09")
		formatString: 0
		displayFolder: Algebra I Completion Measures
		lineageTag: e5aa32f6-84ac-491b-b4f3-21905ffa9b94

	measure '% Algebra I Completion' =
			VAR TotalPass = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[K12StudentId]), 'bi vw_FactK12StudentCourseSections'[GradeLevelCode] = "09", CONTAINSSTRING('bi vw_DimK12Courses'[CourseTitle], "Algebra I"), 'bi vw_FactK12StudentCourseSections'[LetterGradeEarned] <> "F")
			RETURN DIVIDE(TotalPass, [Total 9th Graders], 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Algebra I Completion Measures
		lineageTag: eb9b41af-bd53-482e-a09b-9a0b1b5d3599

	measure 'Algebra I Disaggregate Chart Title' =
			
			VAR SelectedYear = SELECTEDVALUE('bi vw_DimSchoolYears'[SchoolYear])
			VAR SelectedYearTitle = "Algebra I Success Rate " & IF(not ISBLANK(SelectedYear), "for " & SelectedYear, "All Years")
			RETURN
			SelectedYearTitle
		displayFolder: Algebra I Completion Measures
		lineageTag: b4dc14e3-74b2-4e87-9242-a1a98aab7414

	measure 'Disaggregate by' = CONCATENATE(VALUES(Disaggregation[Disaggregation Name]), "")
		displayFolder: Card Titles
		lineageTag: 2730c212-3de6-4be1-a960-5c4742c2bcef

	measure 'Selected Filters' = ```
			
			
			IF(
			    ISFILTERED('bi vw_DimSchoolYears'[SchoolYear])
			    ||
			    ISFILTERED('bi vw_DimCohortGraduationYears'[CohortGraduationYear])
			    ||
			    ISFILTERED('bi vw_DimSEAs'[SeaOrganizationName])
			    ||
			    ISFILTERED('bi vw_DimLEAs'[LeaOrganizationName])
			    ||
			    ISFILTERED('bi vw_DimK12Schools'[NameOfInstitution])
			    ||
			    ISFILTERED('bi vw_DimK12Schools'[SchoolTypeCode])
			    ||
			    ISFILTERED('bi vw_DimRaces'[RaceEthnicity])
			    ||
			    ISFILTERED('bi vw_DimK12Demographics'[Gender])
			    ||
			    ISFILTERED('bi vw_DimDisabilityStatuses'[DisabilityStatus])
			    ||
			    ISFILTERED('bi vw_DimEconomicallyDisadvantagedStatuses'[EconomicDisadvantageStatus])
			    ||
			    ISFILTERED('bi vw_DimEnglishLearnerStatuses'[EnglishLearnerStatus])
			    ||    
			    ISFILTERED('bi vw_DimFosterCareStatuses'[FosterCareStatus])
			    ||    
			    ISFILTERED('bi vw_DimHomelessnessStatuses'[HomelessnessStatus])
			    ||    
			    ISFILTERED('bi vw_DimNeglectedOrDelinquentStatus'[NeglectedOrDelinquentStatus]),
			    
			         IF(
			            ISFILTERED('bi vw_DimSchoolYears'[SchoolYear]),
			            "> Cohort Year: " & CONCATENATEX(VALUES('bi vw_DimSchoolYears'[SchoolYear]), 'bi vw_DimSchoolYears'[SchoolYear], ", "),
			            ""
			        )
			        & " " & 
			         IF(
			            ISFILTERED('bi vw_DimCohortGraduationYears'[CohortGraduationYear]),
			            "> Graduation Year: " & CONCATENATEX(VALUES('bi vw_DimCohortGraduationYears'[CohortGraduationYear]), 'bi vw_DimCohortGraduationYears'[CohortGraduationYear], ", "),
			            ""
			        )     
			        & " " & 
			         IF(
			            ISFILTERED('bi vw_DimSEAs'[SeaOrganizationName]),
			            "> SEAs: " & CONCATENATEX(VALUES('bi vw_DimSEAs'[SeaOrganizationName]), 'bi vw_DimSEAs'[SeaOrganizationName], ", "),
			            ""
			        )     
			        & " " & 
			        IF(
			            ISFILTERED('bi vw_DimLEAs'[LeaOrganizationName]),
			            "> LEAs: " & CONCATENATEX(VALUES('bi vw_DimLEAs'[LeaOrganizationName]), 'bi vw_DimLEAs'[LeaOrganizationName], ", "),
			            ""
			        )
			        & " " & 
			        IF(
			            ISFILTERED('bi vw_DimK12Schools'[NameOfInstitution]),
			            "> School: " & CONCATENATEX(VALUES('bi vw_DimK12Schools'[NameOfInstitution]), 'bi vw_DimK12Schools'[NameOfInstitution], ", "),
			            ""
			        )
			        & " " & 
			        IF(
			            ISFILTERED('bi vw_DimK12Schools'[SchoolTypeCode]),
			            "> School Type: " & CONCATENATEX(VALUES('bi vw_DimK12Schools'[SchoolTypeCode]), 'bi vw_DimK12Schools'[SchoolTypeCode], ", "),
			            ""
			        )
			        & " " & 
			        IF(
			            ISFILTERED('bi vw_DimDisabilityStatuses'[DisabilityStatus]),
			            "> Disability Type: " & CONCATENATEX(VALUES('bi vw_DimDisabilityStatuses'[DisabilityStatus]), 'bi vw_DimDisabilityStatuses'[DisabilityStatus], ", "),
			            ""
			        )
			        & " " & 
			        IF(
			            ISFILTERED('bi vw_DimEnglishLearnerStatuses'[EnglishLearnerStatus]),
			            "> English Learner Status: " & CONCATENATEX(VALUES('bi vw_DimEnglishLearnerStatuses'[EnglishLearnerStatus]), 'bi vw_DimEnglishLearnerStatuses'[EnglishLearnerStatus], ", "),
			            ""
			        )
			        & " " &
			        IF(
			            ISFILTERED('bi vw_DimRaces'[RaceEthnicity]),
			            "> Race/Ethnicity: " & CONCATENATEX(VALUES('bi vw_DimRaces'[RaceEthnicity]), 'bi vw_DimRaces'[RaceEthnicity], ", "),
			            ""
			        )
			        & " " &
			        IF(
			            ISFILTERED('bi vw_DimHomelessnessStatuses'[HomelessnessStatus]),
			            "> Homelessness Status: " & CONCATENATEX(VALUES('bi vw_DimHomelessnessStatuses'[HomelessnessStatus]), 'bi vw_DimHomelessnessStatuses'[HomelessnessStatus], ", "),
			            ""
			        )
			        & " " &
			        IF(
			            ISFILTERED('bi vw_DimK12Demographics'[Gender]),
			            "> Sex: " & CONCATENATEX(VALUES('bi vw_DimK12Demographics'[Gender]), 'bi vw_DimK12Demographics'[Gender], ", "),
			            ""
			        )
			        & " " & 
			        IF(
			            ISFILTERED('bi vw_DimEconomicallyDisadvantagedStatuses'[EconomicDisadvantageStatus]),
			            "> Economically Disadvantaged: " & CONCATENATEX(VALUES('bi vw_DimEconomicallyDisadvantagedStatuses'[EconomicDisadvantageStatus]), 'bi vw_DimEconomicallyDisadvantagedStatuses'[EconomicDisadvantageStatus], ", "),
			            ""
			        )
			        & " " & 
			        IF(
			            ISFILTERED('bi vw_DimFosterCareStatuses'[FosterCareStatus]),
			            "> Foster Care Status: " & CONCATENATEX(VALUES('bi vw_DimFosterCareStatuses'[FosterCareStatus]), 'bi vw_DimFosterCareStatuses'[FosterCareStatus], ", "),
			            ""
			        )
			        & " " & 
			        IF(
			            ISFILTERED('bi vw_DimNeglectedOrDelinquentStatus'[NeglectedOrDelinquentStatus]),
			            "> Neglected or Delinquent Status: " & CONCATENATEX(VALUES('bi vw_DimNeglectedOrDelinquentStatus'[NeglectedOrDelinquentStatus]), 'bi vw_DimNeglectedOrDelinquentStatus'[NeglectedOrDelinquentStatus], ", "),
			            ""
			        )
			    ,
			    "No filters selected"
			
			)
			```
		displayFolder: Card Titles
		lineageTag: 5cc03d6b-dcc4-4694-8e09-682501702631

