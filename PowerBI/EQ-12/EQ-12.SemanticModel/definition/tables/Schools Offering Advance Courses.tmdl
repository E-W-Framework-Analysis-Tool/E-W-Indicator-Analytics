table 'Schools Offering Advance Courses'
	lineageTag: d0bcc2ce-70ce-4414-80f2-81a680dcfa1f

	column Column
		formatString: 0
		lineageTag: 34028059-34af-49c6-9e58-f300f480a06c
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition 'Schools Offering Advance Courses' = calculated
		mode: import
		source = ```
				
				-- 1. Get the list of schools and check their offerings
				VAR SchoolOfferings = 
				    ADDCOLUMNS(
				        DISTINCT('bi vw_FactK12StudentCourseSections'[K12SchoolId]),
				        "OffersAll",
				        VAR EnglishYrs = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "English")
				        VAR MathYrs = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "Math")
				        VAR ScienceYrs = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "Laboratory Science")
				        VAR SocialSciYrs = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "Social Science")
				        VAR ForeignLangYrs =  CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "Foreign Language")
				        VAR ArtsYrs = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), CONTAINSSTRING('bi vw_DimK12Courses'[CourseSubject],"Arts"))
				        
				        RETURN
				        IF(
				            EnglishYrs >= 4 && MathYrs >= 4 && ScienceYrs >= 3 && 
				            SocialSciYrs >= 2 && ForeignLangYrs >= 2 && ArtsYrs >= 1,
				            1, 0
				        )
				    )
				```

	annotation PBI_Id = f5bd3ff0acad4c03a46dd159b9551e6a

