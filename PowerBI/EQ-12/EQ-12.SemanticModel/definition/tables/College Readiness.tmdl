table 'College Readiness'
	lineageTag: b9fc6faf-c77c-42d2-9680-6d4886af4801

	measure 'College Ready Prior Year' = CALCULATE([% College Ready Graduates], 'bi vw_DimSchoolYears'[SchoolYear] = MAX('bi vw_DimSchoolYears'[SchoolYear]) - 1)
		lineageTag: 468a106b-8195-4266-862c-2a9d34708ae6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'College Ready YoY Growth' = [% College Ready Graduates] - [College Ready Prior Year]
		lineageTag: 89dceaea-b1cb-4f47-810d-47d0a6f1177d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Has_1Y_Arts = VAR YearsCount = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), CONTAINSSTRING('bi vw_DimK12Courses'[CourseSubject], "Arts"), 'bi vw_FactK12StudentCourseSections'[LetterGradeEarned] <> "F") RETURN IF(YearsCount >=1,1,0)
		formatString: 0
		displayFolder: College Ready Measures
		lineageTag: bac7da4b-11b8-4529-8248-eb7c4a251661

	measure Has_2Y_ForeignLang = VAR YearsCount = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "Foreign Language", 'bi vw_FactK12StudentCourseSections'[LetterGradeEarned] <> "F") RETURN IF(YearsCount >=2,1,0)
		formatString: 0
		displayFolder: College Ready Measures
		lineageTag: f2194adf-7a4f-4924-aefd-b1c81d66320e

	measure Has_2Y_SocSci = VAR YearsCount = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "Social Science", 'bi vw_FactK12StudentCourseSections'[LetterGradeEarned] <> "F") RETURN IF(YearsCount >=2,1,0)
		formatString: 0
		displayFolder: College Ready Measures
		lineageTag: b3211dfa-eca6-485a-947b-d2abb0e322cd

	measure Has_3Y_LabSci = VAR YearsCount = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "Laboratory Science", 'bi vw_FactK12StudentCourseSections'[LetterGradeEarned] <> "F") RETURN IF(YearsCount >=3,1,0)
		formatString: 0
		displayFolder: College Ready Measures
		lineageTag: 3c0c9448-e995-4bf1-bde4-58bf7a7b5f5b

	measure Has_4Y_Eng = VAR YearsCount = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "English", 'bi vw_FactK12StudentCourseSections'[LetterGradeEarned] <> "F") RETURN IF(YearsCount >=4,1,0)
		formatString: 0
		displayFolder: College Ready Measures
		lineageTag: 2a852779-6e5a-4821-b2b2-a9207a6d341e

	measure Has_4Y_Math = VAR YearsCount = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "Math", 'bi vw_FactK12StudentCourseSections'[LetterGradeEarned] <> "F") RETURN IF(YearsCount >=4,1,0)
		formatString: 0
		displayFolder: College Ready Measures
		lineageTag: 1d2cfe63-ea9c-4374-bb84-3ec36c095cd8

	measure Is_College_Ready = ```
			
			IF(
			    [Has_4Y_Math] = 1 && 
			    [Has_4Y_Eng] = 1 && 
			    [Has_3Y_LabSci] = 1 && 
			    [Has_2Y_SocSci] = 1 && 
			    [Has_2Y_ForeignLang] = 1 && 
			    [Has_1Y_Arts] = 1,
			    1, 0
			)
			```
		formatString: 0
		lineageTag: 2fb27806-880a-4ba5-85e7-1ff00cc28eb0

	measure '% College Ready Graduates' = ```
			
			DIVIDE(
			    SUMX(VALUES('bi vw_FactK12StudentCourseSections'[K12StudentId]), [Is_College_Ready]), 
			    DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[K12StudentId]), 
			    0
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: College Ready Measures
		lineageTag: 46c267a9-fb6a-462c-a430-df62c44db6e5

	measure 'Has Passed' = IF(SELECTEDVALUE('bi vw_FactK12StudentCourseSections'[LetterGradeEarned]) <> "F", 1, 0)
		formatString: 0
		lineageTag: dda77c6f-5a2c-4638-b3f6-18a3d3c7f43a

	measure 'College Prep Graduates' = ```
			
			VAR PassingCourses = 
			    FILTER(
			        'bi vw_FactK12StudentCourseSections',
			        'bi vw_FactK12StudentCourseSections'[LetterGradeEarned] <> "F"
			    )
			RETURN
			COUNTROWS(
			    FILTER(
			        VALUES('bi vw_FactK12StudentEnrollments'[K12StudentId]),
			        VAR StudentID = 'bi vw_FactK12StudentEnrollments'[K12StudentId]
			        
			        -- Logic: Count distinct years the student passed these subjects
			        VAR EnglishYears = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_FactK12StudentCourseSections'[K12StudentId] = StudentID, 'bi vw_DimK12Courses'[CourseTitle] = "English")
			        VAR MathYears = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_FactK12StudentCourseSections'[K12StudentId] = StudentID, 'bi vw_DimK12Courses'[CourseSubject] = "Math")
			        VAR ScienceYears = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_FactK12StudentCourseSections'[K12StudentId] = StudentID, 'bi vw_DimK12Courses'[CourseSubject] = "Science")
			        VAR SocialYears = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_FactK12StudentCourseSections'[K12StudentId] = StudentID, 'bi vw_DimK12Courses'[CourseSubject] = "Social Studies")
			        VAR LangYears = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_FactK12StudentCourseSections'[K12StudentId] = StudentID, 'bi vw_DimK12Courses'[CourseSubject] = "Foreign Language")
			        VAR ArtsYears = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_FactK12StudentCourseSections'[K12StudentId] = StudentID, CONTAINSSTRING('bi vw_DimK12Courses'[CourseSubject], "Arts"))
			
			        RETURN
			        EnglishYears >= 4 && MathYears >= 4 && ScienceYears >= 3 && SocialYears >= 2 && LangYears >= 2 && ArtsYears >= 1
			    )
			)
			```
		formatString: 0
		lineageTag: d3af2943-3354-4378-ab65-2eca6e338c40

	measure 'College Prep Completion Rate' =
			
			VAR TotalGrads = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentAssessments'[K12StudentId]), 'bi vw_FactK12StudentEnrollments'[SchoolYear] = 'bi vw_FactK12StudentEnrollments'[CohortGraduationYear])
			RETURN DIVIDE([College Prep Graduates], TotalGrads, 0)
		lineageTag: c2b08cf0-97d8-458d-888c-a8c817429c2e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total 11-12 Graders' = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentEnrollments'[K12StudentId]), 'bi vw_DimGradeLevels'[GradeLevelCode] IN {"11", "12"})
		formatString: 0
		displayFolder: SAT-ACT Participations
		lineageTag: 30a2f34d-0867-445e-a161-d958a44d4814

	measure 'ACT-SAT Participant Count' =
			
			VAR Result = CALCULATE(
			    DISTINCTCOUNT('bi vw_FactK12StudentAssessments'[K12StudentId]),
			    'bi vw_FactK12StudentAssessments'[SATScore] <> BLANK() || 'bi vw_FactK12StudentAssessments'[ACTScore] <> BLANK(),
			    KEEPFILTERS(CALCULATETABLE('bi vw_FactK12StudentEnrollments', 'bi vw_FactK12StudentEnrollments'[GradeLevelCode] IN {"11", "12"}))
			 )
			 RETURN Result
		formatString: 0
		displayFolder: SAT-ACT Participations
		lineageTag: b9b7ab8d-406b-402d-a60b-a9c4481de6b8

	measure 'College Readiness on ACT-SAT Scores' = ```
			
			VAR SAT_RW_Bench = 480
			VAR SAT_Math_Bench = 530
			VAR ACT_Eng_Bench = 18
			VAR ACT_Math_Bench = 22
			VAR ACT_Read_Bench = 22
			VAR ACT_Sci_Bench = 20
			VAR ACT_Wri_Bench = 21
			
			VAR StudentSubtestScores = SUMMARIZE(
			    'bi vw_FactK12StudentEnrollments',
			    'bi vw_FactK12StudentEnrollments'[CohortGraduationYear],
			    'bi vw_FactK12StudentEnrollments'[K12StudentId],
			        "MaxSAT_RW", CALCULATE(MAX('bi vw_FactK12StudentAssessments'[SATScore]), KEEPFILTERS('bi vw_DimAssessmentSubtests'[AssessmentSubtestCode]  = "SAT-RW")),
			        "MaxSAT_Math", CALCULATE(MAX('bi vw_FactK12StudentAssessments'[SATScore]), KEEPFILTERS('bi vw_DimAssessmentSubtests'[AssessmentSubtestCode]  = "SAT-M")),
			        "MaxACT_Eng", CALCULATE(MAX('bi vw_FactK12StudentAssessments'[ACTScore]), KEEPFILTERS('bi vw_DimAssessmentSubtests'[AssessmentSubtestCode]  = "ACT-ENG")),
			        "MaxACT_Math", CALCULATE(MAX('bi vw_FactK12StudentAssessments'[ACTScore]), KEEPFILTERS('bi vw_DimAssessmentSubtests'[AssessmentSubtestCode]  = "ACT-M")),
			        "MaxACT_Read", CALCULATE(MAX('bi vw_FactK12StudentAssessments'[ACTScore]), KEEPFILTERS('bi vw_DimAssessmentSubtests'[AssessmentSubtestCode]  = "ACT-R")),
			        "MaxACT_Sci", CALCULATE(MAX('bi vw_FactK12StudentAssessments'[ACTScore]), KEEPFILTERS('bi vw_DimAssessmentSubtests'[AssessmentSubtestCode]  = "ACT-S")),
			        "MaxACT_Wri", CALCULATE(MAX('bi vw_FactK12StudentAssessments'[ACTScore]), KEEPFILTERS('bi vw_DimAssessmentSubtests'[AssessmentSubtestCode]  = "ACT-W"))
			    )
			RETURN
			COUNTROWS(FILTER(StudentSubtestScores, 
			( [MaxSAT_RW] >= SAT_RW_Bench && [MaxSAT_Math] >= SAT_Math_Bench ) ||
			        ( [MaxACT_Eng] >= ACT_Eng_Bench && [MaxACT_Math] >= ACT_Math_Bench && [MaxACT_Read] >= ACT_Read_Bench && [MaxACT_Sci] >= ACT_Sci_Bench && [MaxACT_Wri] >= ACT_Wri_Bench  )
			))
			```
		formatString: 0
		displayFolder: SAT-ACT Participations
		lineageTag: 1988389e-77b2-43f8-a006-a68edf934eb8

	measure 'ACT-SAT College Readiness' = IF([ACT-SAT Participant Count] = 0, 0, DIVIDE([College Readiness on ACT-SAT Scores], [ACT-SAT Participant Count], 0))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SAT-ACT Participations
		lineageTag: 7a1b237e-732a-4869-9064-160e603780c5

	measure 'College Readiness Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineGraduationYears[CohortGraduationYear])
			RETURN
			CALCULATE(
			    'College Readiness'[% College Ready Graduates],
			    'bi vw_DimSchoolYears'[SchoolYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimSchoolYears')
			)
		displayFolder: College Ready Measures
		lineageTag: a843d23f-014a-4a9c-8607-d71a2aba2847

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ACT-SAT Participation Rate' = IF([Total 11-12 Graders] = 0, 0, DIVIDE([ACT-SAT Participant Count], [Total 11-12 Graders], 0))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SAT-ACT Participations
		lineageTag: 3f9b7145-77bb-4128-8a32-f7ea020d4be0

	measure 'SAT-ACT Disaggregate Chart Title' =
			
			VAR SelectedYear = SELECTEDVALUE('bi vw_DimSchoolYears'[SchoolYear])
			VAR SelectedYearTitle = "SAT/ACT Participation Rate " & IF(not ISBLANK(SelectedYear), "for " & SelectedYear, "All Years")
			RETURN
			SelectedYearTitle
		displayFolder: SAT-ACT Participations
		lineageTag: 3e7f3b8d-db8e-4bec-a0c0-ffaa3de87061

	measure 'ACT-SAT Participation Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineYears[SchoolYear])
			RETURN
			CALCULATE(
			    [ACT-SAT Participation Rate],
			    'bi vw_DimSchoolYears'[SchoolYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimSchoolYears'[SchoolYear]
			))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SAT-ACT Participations
		lineageTag: 147960a4-c58a-45f5-b836-750f0e198a0d

	measure 'ACT-SAT College Readiness Trend' =
			
			VAR SelectedTrendYear = SELECTEDVALUE(TrendLineYears[SchoolYear])
			RETURN
			CALCULATE(
			    [ACT-SAT College Readiness],
			    'bi vw_DimSchoolYears'[SchoolYear] = SelectedTrendYear,
			    REMOVEFILTERS('bi vw_DimCohortGraduationYears'[CohortGraduationYear]
			))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SAT-ACT Participations
		lineageTag: ad41363f-e3ae-43d5-8f16-aa3cf3b8cb81

	partition 'College Readiness' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

