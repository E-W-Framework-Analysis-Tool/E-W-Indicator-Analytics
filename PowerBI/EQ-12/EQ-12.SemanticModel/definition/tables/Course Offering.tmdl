table 'Course Offering'
	lineageTag: d3345126-e524-4d28-9d9f-b56be842af23

	measure TotalSchools = DISTINCTCOUNT('bi vw_DimK12Schools'[DimK12SchoolId])
		formatString: 0
		lineageTag: 46269d25-086e-452c-9168-9ce4b61a886d

	measure 'Schools Offering Required Curriculum' = ```
			
			-- 1. Get the list of schools and check their offerings
			VAR SchoolOfferings = 
			    ADDCOLUMNS(
			        DISTINCT('bi vw_FactK12StudentCourseSections'[K12SchoolId]),
			        "OffersAll",
			        VAR EnglishYrs = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "English")
			        VAR MathYrs = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "Math")
			        VAR ScienceYrs = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "Laboratory Science")
			        VAR SocialSciYrs = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "Social Science")
			        VAR ForeignLangYrs =  CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), 'bi vw_DimK12Courses'[CourseSubject] = "Foreign Language")
			        VAR ArtsYrs = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), CONTAINSSTRING('bi vw_DimK12Courses'[CourseSubject],"Arts"))
			        
			        RETURN
			        IF(
			            EnglishYrs >= 4 && MathYrs >= 4 && ScienceYrs >= 3 && 
			            SocialSciYrs >= 2 && ForeignLangYrs >= 2 && ArtsYrs >= 1,
			            1, 0
			        )
			    )
			
			-- 2. Count how many schools offer the full set
			VAR SchoolsOffering = SUMX(SchoolOfferings, [OffersAll])
			RETURN COUNTROWS(SchoolOfferings)
			```
		formatString: 0
		lineageTag: 51e01de8-f7f0-4bfe-b169-8da28de75e9e

	measure 'Course Offering Rate' = IF([TotalSchools] = 0, 0, DIVIDE([Schools Offering Required Curriculum], [TotalSchools], 0))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c789deaa-b0b6-4d99-a20d-05bb02b9edb2

	measure 'Schools Offering Algebra I' = ```
			
			VAR SchoolOfferings = 
			    ADDCOLUMNS(
			        DISTINCT('bi vw_FactK12StudentCourseSections'[K12SchoolId]),
			        "OffersAll",
			        VAR AlgebraYrs = CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[SchoolYear]), CONTAINSSTRING('bi vw_DimK12Courses'[CourseTitle], "Algebra I"))
			        
			        RETURN
			        IF(
			            AlgebraYrs >= 1,
			            1, 0
			        )
			    )
			
			-- 2. Count how many schools offer the full set
			VAR SchoolsOffering = SUMX(SchoolOfferings, [OffersAll])
			RETURN COUNTROWS(SchoolOfferings)
			```
		formatString: 0
		lineageTag: 9f93292c-9c75-4107-82cd-64705c9d6aef

	measure 'Algebra I Offering Rate' = IF([TotalSchools] = 0, 0, DIVIDE([Schools Offering Algebra I], [TotalSchools], 0))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6285b008-893e-4b07-a67d-d4a589a79a5c

	measure 'Schools Offering Advance Courses' =
			
			CALCULATE(DISTINCTCOUNT('bi vw_FactK12StudentCourseSections'[K12SchoolId]), KEEPFILTERS(CALCULATETABLE('bi vw_DimK12CourseStatuses', 'bi vw_DimK12CourseStatuses'[CourseLevel] IN {"AP", "IB", "Dual Credit"})))
		formatString: 0
		lineageTag: 1d56d8e4-f083-47fa-bf16-128c63e6df40

