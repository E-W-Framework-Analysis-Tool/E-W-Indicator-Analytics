                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
 fkse.FactK12StudentEnrollmentId
,dsy3.SchoolYear AS CohortYear
,dsy.SchoolYear
,dsy2.SchoolYear AS CohortGraduationYear
,dsy4.SchoolYear AS ProjectedGraduationYear
,ds.SeaOrganizationIdentifierSea
,dl.LeaIdentifierSea
,dks.SchoolIdentifierSea
,dp.StudentIdentifierState
,dr.RaceCode
,cast(dgl.GradeLevelCode as varchar(8)) as GradeLevelCode
,dels.EnglishLearnerStatusCode
,dhs.HomelessnessStatusCode
,deds.EconomicDisadvantageStatusCode
,dfcs.ProgramParticipationFosterCareCode
,dnds.NeglectedOrDelinquentAcademicAchievementIndicatorCode
,dds.DisabilityStatusCode
,dkd.SexCode
FROM RDS.FactK12StudentEnrollments as fkse
LEFT JOIN RDS.DimSchoolYears as dsy
on dsy.DimSchoolYearId = fkse.SchoolYearId
LEFT JOIN RDS.DimSchoolYears as dsy2
on fkse.CohortGraduationYearId = dsy2.DimSchoolYearId
LEFT JOIN RDS.DimSchoolYears as dsy3
on fkse.CohortYearId = dsy3.DimSchoolYearId
LEFT JOIN RDS.DimSchoolYears as dsy4
on fkse.ProjectedGraduationDateId = dsy4.DimSchoolYearId
LEFT JOIN RDS.DimSeas AS ds 
ON ds.DimSeaId = fkse.SeaId
LEFT JOIN RDS.DimLeas AS dl
on dl.DimLeaId = fkse.LeaAttendanceId
LEFT JOIN RDS.DimK12Schools AS dks
on fkse.K12SchoolId = dks.DimK12SchoolId
LEFT JOIN RDS.DimPeople AS dp
on fkse.K12StudentId = dp.DimPersonId
LEFT JOIN RDS.DimGradeLevels AS dgl
on fkse.EntryGradeLevelId= dgl.DimGradeLevelId
LEFT JOIN RDS.DimEnglishLearnerStatuses AS dels
ON fkse.EnglishLearnerStatusId = dels.DimEnglishLearnerStatusId
LEFT JOIN RDS.DimHomelessnessStatuses AS dhs
on fkse.HomelessnessStatusId = dhs.DimHomelessnessStatusId
LEFT JOIN RDS.DimMilitaryStatuses AS dms
on fkse.MilitaryStatusId = dms.DimMilitaryStatusId
LEFT JOIN RDS.DimEconomicallyDisadvantagedStatuses AS deds
ON fkse.EconomicallyDisadvantagedStatusId = deds.DimEconomicallyDisadvantagedStatusId
LEFT JOIN RDS.DimFosterCareStatuses AS dfcs
on fkse.FosterCareStatusId = dfcs.DimFosterCareStatusId
left join RDS.DimNOrDStatuses as dnds
on fkse.NOrDStatusId = dnds.DimNOrDStatusId
LEFT JOIN RDS.DimDisabilityStatuses AS dds
ON fkse.DisabilityStatusId = dds.DimDisabilityStatusId
LEFT JOIN RDS.BridgeK12StudentEnrollmentRaces AS bker
on fkse.FactK12StudentEnrollmentId = bker.FactK12StudentEnrollmentId
LEFT JOIN RDS.DimRaces AS dr
ON bker.RaceId = dr.DimRaceId
LEFT JOIN RDS.DimK12Demographics AS dkd
ON fkse.K12DemographicId = dkd.DimK12DemographicId
WHERE dsy.SchoolYear &gt; ?
ORDER BY fkse.FactK12StudentEnrollmentId</property>
