                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    fkscs.FactK12StudentCourseSectionId,
    fkse.FactK12StudentEnrollmentId,
    dsy.SchoolYear,
    ds.SeaOrganizationIdentifierSea,
    dl.LeaIdentifierSea,
    dks.SchoolIdentifierSea,
    dp.StudentIdentifierState,
    cast(dgl.GradeLevelCode as varchar(8)) as GradeLevelCode,
    dkc.CourseIdentifier,
    dkcs.CourseLevelCharacteristicCode,
    fkscs.StudentCourseSectionGradeEarned,
    fkscs.StudentCourseSectionGradeNarrative
FROM
    RDS.FactK12StudentCourseSections AS fkscs
    LEFT JOIN RDS.FactK12StudentEnrollments as fkse on fkscs.SchoolYearId = fkse.SchoolYearId
    and fkscs.SeaId = fkse.SeaId
    AND fkscs.LeaAttendanceId = fkse.LeaAttendanceId
    and fkscs.K12SchoolId = fkse.K12SchoolId
    and fkscs.K12StudentId = fkse.K12StudentId
    and fkscs.K12StudentId = fkse.K12StudentId
    and fkscs.EntryGradeLevelId = fkse.EntryGradeLevelId
    LEFT JOIN RDS.DimSchoolYears as dsy on dsy.DimSchoolYearId = fkscs.SchoolYearId
    LEFT JOIN RDS.DimSeas AS ds ON ds.DimSeaId = fkscs.SeaId
    LEFT JOIN RDS.DimLeas AS dl on dl.DimLeaId = fkscs.LeaAttendanceId
    LEFT JOIN RDS.DimK12Schools AS dks on fkscs.K12SchoolId = dks.DimK12SchoolId
    LEFT JOIN RDS.DimPeople AS dp on fkscs.K12StudentId = dp.DimPersonId
    LEFT JOIN RDS.DimGradeLevels AS dgl on fkscs.EntryGradeLevelId = dgl.DimGradeLevelId
    LEFT JOIN RDS.DimK12Courses AS dkc ON fkscs.LeaK12CourseId = dkc.DimK12CourseId
    LEFT JOIN RDS.DimK12CourseStatuses AS dkcs ON fkscs.K12CourseStatusId = dkcs.DimK12CourseStatusId
where
    dsy.SchoolYear &gt; ?
ORDER BY
    FactK12StudentCourseSectionId</property>
