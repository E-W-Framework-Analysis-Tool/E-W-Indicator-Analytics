    <DTS:Executable
      DTS:refId="Package\Update Batch Control"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{54353073-d64f-46f1-8994-be53cb6dfc95}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update Batch Control"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{60dda06b-3f51-4553-8452-daaed09fbd3d}"
          SQLTask:SqlStatementSource="INSERT&#xA;INTO [etl].[BatchControl]&#xA; (&#xA;  [YearProcessed]&#xA; )&#xA;SELECT [src].[SchoolYear]&#xA;FROM&#xA; (SELECT DISTINCT [SchoolYear] FROM [reporting].[FactK12StudentEnrollments]) AS [src]([SchoolYear])&#xA;WHERE&#xA; NOT EXISTS(SELECT 1&#xA;      FROM [etl].[BatchControl] AS [tgt]&#xA;      WHERE [tgt].[YearProcessed] = [src].[SchoolYear])&#xA;ORDER BY&#xA; [SchoolYear];" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
