                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    [FactPsStudentAcademicAwardId]
  , [dpi].[IPEDSIdentifier]
  , [dp].[PsStudentStudentIdentifierState]
  , [PsAcademicAwardTitleId]
  , [dd].[DateValue] AS [AcademicAwardDate]
  , [PsAcademicAwardStatusId]
  , [dsy1].[SchoolYear]
  , [dpd].[SexDescription]
FROM
	[RDS].[FactPsStudentAcademicAwards]     AS [base]
		LEFT JOIN [RDS].[DimSchoolYears]    AS [dsy1]
					  ON [base].[SchoolYearId] = [dsy1].[DimSchoolYearId]
		LEFT JOIN [RDS].[DimPsDemographics] AS [dpd]
					  ON [base].[PsDemographicId] = [dpd].[DimPsDemographicId]
		LEFT JOIN [RDS].[DimDates]          AS [dd]
					  ON [base].[AcademicAwardDateId] = [dd].[DimDateId]
		LEFT JOIN [RDS].[DimPeople]         AS [dp]
					  ON [base].[PsStudentId] = [dp].[DimPersonId]
		LEFT JOIN [RDS].[DimPsInstitutions] AS [dpi]
					  ON [base].[PsInstitutionId] = [dpi].[DimPsInstitutionId]</property>
                    <property
